{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "es2020",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@vibe-dashboard/workflow-core": ["./packages/workflow-core/src/index.ts"],
      "@vibe-dashboard/beads-form": ["./packages/beads-form/src/index.ts"],
      "@vibe/inline-chat": ["./src/types/vibe-inline-chat.d.ts"],
      "@vibe/ui": ["./vibe-kanban/packages/ui/src"],
      "@vibe/ui/*": ["./vibe-kanban/packages/ui/src/*"],
      "@vibe/web-core": ["./vibe-kanban/packages/web-core/src"],
      "@vibe/web-core/*": ["./vibe-kanban/packages/web-core/src/*"],
      "@web/*": ["./vibe-kanban/packages/local-web/src/*"],
      "shared": ["./vibe-kanban/shared/types.ts"],
      "shared/*": ["./vibe-kanban/shared/*"],
      "@/*": ["./vibe-kanban/packages/web-core/src/*", "./src/*"]
    },

    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    // "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "exclude": ["scripts/vibe-agent/**", "vibe-kanban/**"]
}
